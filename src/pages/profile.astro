---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { SITE } from '../config/site';

// 略歴は「期間 + 内容」の対のため <dl> + <dt>/<dd> でマークアップ。
// 内容が複数段落になる場合は <dd> 内に <p> を並べる。
// <dl> の直接の子は dt/dd のみ（WCAG definition-list ルール）。
const career = [
  {
    period: '卒業後',
    body: [
      '法人対象のセールスマンとしてキャリアをスタート。業界は建設業、飲食業、ホームセンター本部、コスメと多岐にわたり、営業先では顧客とともにダンプカーやショベルカーの操作、飲食店の厨房、ホームセンターの店頭販売、コスメ店の店舗ディスプレイと現場を経験し、机上の論理だけにとどまらない経験を積む。',
      '当時の業界経験は、現在 K Laboratory が伴走支援する建設業・サービス業のお客様へのコンサルティングの基盤となっている。',
    ],
  },
  {
    period: '在職中',
    body: [
      '顧客との共同作業の成果もあり、3 年連続で全国トップの営業成績を獲得。',
    ],
  },
  {
    period: '1995 年頃',
    body: [
      'Windows 95 とインターネットの普及を機に IT 業界へ転職。ネットワークエンジニアとして IT 業界のキャリアをスタートし、その後一貫して IT 業界に携わる。',
    ],
  },
  {
    period: '2003 年 2 月',
    body: ['有限会社 K Laboratory を設立、独立。'],
  },
  {
    period: '2003 年 2 月〜',
    body: [
      'IT コンサルティング・システム開発に従事。営業職時代の経験と経営的視点を活かした提案が好評。',
    ],
  },
  {
    period: '2025 年夏',
    body: [
      'AI の飛躍的発展を新たな時代の要請と捉え、AI 駆動開発へシフト。',
    ],
  },
] as const;
---

<Layout
  title="代表略歴"
  description="有限会社 K Laboratory 代表 川﨑 伸之 の略歴をご紹介します。"
>
  <section class="page-header">
    <div class="container">
      <h1>代表略歴</h1>
      <p class="page-header__lead">
        代表者 {SITE.company.representative} の経歴をご紹介します。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="profile-hero">
        <div class="profile-hero__photo">
          <ResponsiveImage
            src="/images/prof.jpg"
            alt="代表者 川﨑 伸之"
            width={800}
            height={619}
            loading="eager"
            class="profile-hero__photo-img"
          />
        </div>
        <div class="profile-hero__intro">
          <p class="profile-hero__name">{SITE.company.representative}</p>
          <p class="profile-hero__role">代表取締役</p>
          <p class="profile-hero__summary">
            30 年にわたる IT 領域での経験を土台に、近年は AI 駆動開発を軸とした事業を展開。中小企業の IT・AI 導入の伴走支援を主な活動領域としています。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <SectionHeading title="略歴" />
      <dl class="career-timeline">
        {
          career.map((c) => (
            <>
              <dt class="career-timeline__period">{c.period}</dt>
              <dd class="career-timeline__body">
                {c.body.map((p) => <p>{p}</p>)}
              </dd>
            </>
          ))
        }
      </dl>
    </div>
  </section>

  {/* ===== 営業時代のループ ── 4 業界 + 全国トップ収束図 ===== */}
  <section class="section">
    <div class="container">
      <SectionHeading
        title="「現場を知る提案ループ」── 営業時代の方法論"
        lead="「商談 → 現場体験 → 現場のままフィードバック → 提案採用」の独自プロセスで、4 業界での現場経験を積み重ね、3 年連続全国トップの営業成績を実現しました。"
      />
      <ul class="career-loop">
        <li class="career-loop__item">
          <figure class="career-loop__figure">
            <ResponsiveImage
              src="/images/career/career-construction.jpg"
              alt="建設業のループ：スーツ姿で社長と商談 → 作業着でショベルカーを実際に操作 → 作業着のまま社長室で現場の声をフィードバック → 提案採用・契約成立"
              width={1400}
              height={933}
              class="career-loop__img"
            />
          </figure>
        </li>
        <li class="career-loop__item">
          <figure class="career-loop__figure">
            <ResponsiveImage
              src="/images/career/career-food.jpg"
              alt="飲食業のループ：スーツ姿で店長と商談 → コックコートで厨房で実際に料理 → コックコートのまま店長室で現場の声をフィードバック → 提案採用・契約成立"
              width={1400}
              height={933}
              class="career-loop__img"
            />
          </figure>
        </li>
        <li class="career-loop__item">
          <figure class="career-loop__figure">
            <ResponsiveImage
              src="/images/career/career-homecenter.jpg"
              alt="ホームセンター本部のループ：スーツ姿で本部バイヤーと商談 → 店舗エプロンで店頭で接客販売 → エプロンのまま本部バイヤー室で現場の声をフィードバック → 提案採用・契約成立"
              width={1400}
              height={933}
              class="career-loop__img"
            />
          </figure>
        </li>
        <li class="career-loop__item">
          <figure class="career-loop__figure">
            <ResponsiveImage
              src="/images/career/career-cosmetics.jpg"
              alt="コスメブランド本部のループ：スーツ姿で女性ブランドバイヤーと商談 → 店舗エプロンでコスメ売場で実際にディスプレイ作業 → エプロンのままバイヤー室で現場の声をフィードバック → 提案採用・契約成立"
              width={1400}
              height={933}
              class="career-loop__img"
            />
          </figure>
        </li>
        <li class="career-loop__item career-loop__item--climax">
          <figure class="career-loop__figure">
            <ResponsiveImage
              src="/images/career/career-climax.jpg"
              alt="3 年連続全国トップセールスのクライマックス：若手代表がトロフィーを掲げ、4 業界のお客様（建設社長・飲食店長・ホームセンター本部バイヤー・コスメブランドバイヤー）全員がサムズアップで支持を示す祝祭の場面"
              width={1400}
              height={933}
              class="career-loop__img"
            />
          </figure>
        </li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .profile-hero {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 32px;
    align-items: start;
  }
  .profile-hero__name {
    font-size: 22px;
    font-weight: 700;
    margin: 0 0 4px;
    color: var(--c-text);
  }
  .profile-hero__role {
    font-size: 14px;
    color: var(--c-orange-text);
    font-weight: 600;
    margin: 0 0 16px;
    letter-spacing: 0.04em;
  }
  .profile-hero__summary {
    margin: 0;
    line-height: 1.9;
    color: var(--c-text-sub);
  }
  @media (max-width: 720px) {
    .profile-hero {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  .profile-hero__photo-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    display: block;
  }

  /* 略歴タイムライン ── 期間 + 内容のペアを縦に列挙。
     モバイル：1 列縦並び。720px 以上：「期間」カラム + 「内容」カラムの 2 列。 */
  .career-timeline {
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }
  .career-timeline__period {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 700;
    color: var(--c-orange-text);
    letter-spacing: 0.02em;
    padding-left: 14px;
    border-left: 4px solid var(--c-orange-700);
    line-height: 1.5;
  }
  .career-timeline__body {
    margin: 0;
    padding-left: 18px;
    font-size: 15px;
    color: var(--c-text);
    line-height: 1.95;
  }
  .career-timeline__body p {
    margin: 0 0 14px;
  }
  .career-timeline__body p:last-child {
    margin-bottom: 0;
  }

  @media (min-width: 720px) {
    /* デスクトップでは「期間」カラム + 「内容」カラムの 2 列レイアウト */
    .career-timeline {
      grid-template-columns: minmax(140px, 180px) 1fr;
      gap: 24px 32px;
      align-items: baseline;
    }
    .career-timeline__period {
      margin: 0;
    }
    .career-timeline__body {
      padding-left: 0;
    }
  }

  /* 営業時代のループ画像群 ── 4 業界（建設/飲食/ホムセン/コスメ）
     + 全国トップ収束図 を縦に並べる。サイト全体の他セクション
     （problems / RISK / PROMISE / FLOW 等）と同じ縦並び・大判表示の
     視覚言語に揃える。内部の 4 パネルテキスト可読性も担保される。 */
  .career-loop {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .career-loop__item {
    margin: 0;
  }
  .career-loop__figure {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--c-border);
    background: var(--c-bg-alt);
    box-shadow: var(--shadow);
  }
  .career-loop__img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
