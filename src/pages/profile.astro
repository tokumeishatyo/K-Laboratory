---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { SITE } from '../config/site';

// 略歴は「期間 + 内容」の対のため <dl> + <dt>/<dd> でマークアップ。
// 内容が複数段落になる場合は <dd> 内に <p> を並べる。
// <dl> の直接の子は dt/dd のみ（WCAG definition-list ルール）。
const career = [
  {
    period: '卒業後',
    body: [
      '法人対象のセールスマンとしてキャリアをスタート。業界は建設業、飲食業、ホームセンター本部、コスメと多岐にわたり、営業先では顧客とともにダンプカーやショベルカーの操作、飲食店の厨房、ホームセンターの店頭販売、コスメ店の店舗ディスプレイと現場を経験し、机上の論理だけにとどまらない経験を積む。',
      '当時の業界経験は、現在 K Laboratory が伴走支援する建設業・サービス業のお客様へのコンサルティングの基盤となっている。',
    ],
  },
  {
    period: '在職中',
    body: [
      '顧客との共同作業の成果もあり、3 年連続で全国トップの営業成績を獲得。',
    ],
  },
  {
    period: '1995 年頃',
    body: [
      'Windows 95 とインターネットの普及を機に IT 業界へ転職。ネットワークエンジニアとして IT 業界のキャリアをスタートし、その後一貫して IT 業界に携わる。',
    ],
  },
  {
    period: '2003 年 2 月',
    body: ['有限会社 K Laboratory を設立、独立。'],
  },
  {
    period: '2003 年 2 月〜',
    body: [
      'IT コンサルティング・システム開発に従事。営業職時代の経験と経営的視点を活かした提案が好評。',
    ],
  },
  {
    period: '2025 年夏',
    body: [
      'AI の飛躍的発展を新たな時代の要請と捉え、AI 駆動開発へシフト。',
    ],
  },
] as const;
---

<Layout
  title="代表略歴"
  description="有限会社 K Laboratory 代表 川﨑 伸之 の略歴をご紹介します。"
>
  <section class="page-header">
    <div class="container">
      <h1>代表略歴</h1>
      <p class="page-header__lead">
        代表者 {SITE.company.representative} の経歴をご紹介します。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="profile-hero">
        <div class="profile-hero__photo">
          <ResponsiveImage
            src="/images/prof.jpg"
            alt="代表者 川﨑 伸之"
            width={800}
            height={619}
            loading="eager"
            class="profile-hero__photo-img"
          />
        </div>
        <div class="profile-hero__intro">
          <p class="profile-hero__name">{SITE.company.representative}</p>
          <p class="profile-hero__role">代表取締役</p>
          <p class="profile-hero__summary">
            30 年にわたる IT 領域での経験を土台に、近年は AI 駆動開発を軸とした事業を展開。中小企業の IT・AI 導入の伴走支援を主な活動領域としています。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <SectionHeading title="略歴" />
      <dl class="career-timeline">
        {
          career.map((c) => (
            <>
              <dt class="career-timeline__period">{c.period}</dt>
              <dd class="career-timeline__body">
                {c.body.map((p) => <p>{p}</p>)}
              </dd>
            </>
          ))
        }
      </dl>
    </div>
  </section>

  {/* ===== 営業時代のループ ── 4 業界 + 全国トップ収束図 ===== */}
  <section class="section">
    <div class="container">
      <SectionHeading
        title="「現場を知る提案ループ」── 営業時代の方法論"
        lead="「商談 → 現場体験 → 現場のままフィードバック → 提案採用」の独自プロセスで、4 業界での現場経験を積み重ね、3 年連続全国トップの営業成績を実現しました。"
      />
      <ul class="career-loop">
        <li class="career-loop__item">
          <a
            href="/images/career/career-construction.jpg"
            target="_blank"
            rel="noopener"
            class="career-loop__zoom"
            aria-label="建設業ループの画像を拡大表示します（新しいタブで開きます）"
          >
            <figure class="career-loop__figure">
              <ResponsiveImage
                src="/images/career/career-construction.jpg"
                alt="建設業のループ：スーツ姿で社長と商談 → 作業着でショベルカーを実際に操作 → 作業着のまま社長室で現場の声をフィードバック → 提案採用・契約成立"
                width={1400}
                height={933}
                class="career-loop__img"
              />
              <span class="career-loop__zoom-badge" aria-hidden="true">🔍 拡大</span>
            </figure>
          </a>
        </li>
        <li class="career-loop__item">
          <a
            href="/images/career/career-food.jpg"
            target="_blank"
            rel="noopener"
            class="career-loop__zoom"
            aria-label="飲食業ループの画像を拡大表示します（新しいタブで開きます）"
          >
            <figure class="career-loop__figure">
              <ResponsiveImage
                src="/images/career/career-food.jpg"
                alt="飲食業のループ：スーツ姿で店長と商談 → コックコートで厨房で実際に料理 → コックコートのまま店長室で現場の声をフィードバック → 提案採用・契約成立"
                width={1400}
                height={933}
                class="career-loop__img"
              />
              <span class="career-loop__zoom-badge" aria-hidden="true">🔍 拡大</span>
            </figure>
          </a>
        </li>
        <li class="career-loop__item">
          <a
            href="/images/career/career-homecenter.jpg"
            target="_blank"
            rel="noopener"
            class="career-loop__zoom"
            aria-label="ホームセンター本部ループの画像を拡大表示します（新しいタブで開きます）"
          >
            <figure class="career-loop__figure">
              <ResponsiveImage
                src="/images/career/career-homecenter.jpg"
                alt="ホームセンター本部のループ：スーツ姿で本部バイヤーと商談 → 店舗エプロンで店頭で接客販売 → エプロンのまま本部バイヤー室で現場の声をフィードバック → 提案採用・契約成立"
                width={1400}
                height={933}
                class="career-loop__img"
              />
              <span class="career-loop__zoom-badge" aria-hidden="true">🔍 拡大</span>
            </figure>
          </a>
        </li>
        <li class="career-loop__item">
          <a
            href="/images/career/career-cosmetics.jpg"
            target="_blank"
            rel="noopener"
            class="career-loop__zoom"
            aria-label="コスメブランド本部ループの画像を拡大表示します（新しいタブで開きます）"
          >
            <figure class="career-loop__figure">
              <ResponsiveImage
                src="/images/career/career-cosmetics.jpg"
                alt="コスメブランド本部のループ：スーツ姿で女性ブランドバイヤーと商談 → 店舗エプロンでコスメ売場で実際にディスプレイ作業 → エプロンのままバイヤー室で現場の声をフィードバック → 提案採用・契約成立"
                width={1400}
                height={933}
                class="career-loop__img"
              />
              <span class="career-loop__zoom-badge" aria-hidden="true">🔍 拡大</span>
            </figure>
          </a>
        </li>
        <li class="career-loop__item career-loop__item--climax">
          <figure class="career-loop__figure">
            <ResponsiveImage
              src="/images/career/career-climax.jpg"
              alt="3 年連続全国トップセールスのクライマックス：若手代表がトロフィーを掲げ、4 業界のお客様（建設社長・飲食店長・ホームセンター本部バイヤー・コスメブランドバイヤー）全員がサムズアップで支持を示す祝祭の場面"
              width={1400}
              height={933}
              class="career-loop__img"
            />
          </figure>
        </li>
      </ul>
    </div>
  </section>

  {/* ===== IT 業界編 ── 5 枚シリーズ（進出 + 全工程 + 起業 + 3 視点 + AI 駆動） =====
       前半 2 枚（進出ループ + 全工程経験）= キャリア初期の方法論と技術習得 → 2x2 田の字
       後半 3 枚（起業 + 3 視点 + AI 駆動）= 節目の年表（2003〜現在）→ 縦並び大表示
       1, 2 番は同じキャリア初期段階を並列に並べる構造、3 番以降は時系列の節目なので
       レイアウトを変えてそれぞれの構造を視覚的にも伝える。 */}
  <section class="section section--alt">
    <div class="container">
      <SectionHeading
        title="IT 業界での歩み ── 進出から、AI 駆動の今まで"
        lead="1995 年、営業時代に確立した「現場を知る提案ループ」を IT 業界へ転用してキャリアをスタート。ネットワーク・開発・要件設計・テストの 4 領域を横断的に習得し、2003 年 2 月に独立。以後、3 視点を持つジェネラリストとして進化を続け、現在は AI 駆動へとシフトしています。"
      />

      {/* 前半 2 枚 ── 営業ノウハウ転用ループ + 4 領域横断（同時期の並列要素） */}
      <ul class="career-loop">
        <li class="career-loop__item">
          <a
            href="/images/career/career-it-routine.jpg"
            target="_blank"
            rel="noopener"
            class="career-loop__zoom"
            aria-label="IT 進出ループの画像を拡大表示します（新しいタブで開きます）"
          >
            <figure class="career-loop__figure">
              <ResponsiveImage
                src="/images/career/career-it-routine.jpg"
                alt="IT 進出ループ：スーツ姿で情シス課長と商談 → 作業着で LAN 配線・サーバ設置を実作業 → 作業着のまま情シス課長へ現場の声をフィードバック → 全社 LAN 構築の発注（提案採用・契約成立）"
                width={1400}
                height={933}
                class="career-loop__img"
              />
              <span class="career-loop__zoom-badge" aria-hidden="true">🔍 拡大</span>
            </figure>
          </a>
        </li>
        <li class="career-loop__item">
          <a
            href="/images/career/career-it-fullstack.jpg"
            target="_blank"
            rel="noopener"
            class="career-loop__zoom"
            aria-label="IT 全工程経験の画像を拡大表示します（新しいタブで開きます）"
          >
            <figure class="career-loop__figure">
              <ResponsiveImage
                src="/images/career/career-it-fullstack.jpg"
                alt="IT 全工程経験：紺スーツの主人公が 4 領域（ネットワーク：サーバ・LAN・WAN の設計と実装 / 開発：業務システムのアプリケーション実装 / 要件設計：顧客と協働しての業務分析・仕様策定 / テスト：品質検証と運用引き渡し）を 1 人で横断的にカバーした実務経験を 1995〜2003 頃の時代背景で示す並列 4 領域図"
                width={1400}
                height={933}
                class="career-loop__img"
              />
              <span class="career-loop__zoom-badge" aria-hidden="true">🔍 拡大</span>
            </figure>
          </a>
        </li>
      </ul>

      {/* 後半 3 枚 ── 節目の年表（2003 起業 → 進化 → 現在の AI 駆動）
           時系列の節目なので 1 枚ずつ大きく縦並びで配置し、ストーリーの進行を強調。 */}
      <ul class="career-stages">
        <li class="career-stages__item">
          <a
            href="/images/career/career-it-founding.jpg"
            target="_blank"
            rel="noopener"
            class="career-stages__zoom"
            aria-label="K Laboratory 創業の画像を拡大表示します（新しいタブで開きます）"
          >
            <figure class="career-stages__figure">
              <ResponsiveImage
                src="/images/career/career-it-founding.jpg"
                alt="K Laboratory 創業：2003 年 2 月、若手の主人公が新オフィスのドア横に「有限会社 K Laboratory」のプレートを取り付けている瞬間。脚立に乗りドライバでネジ留めしながら、観葉植物の新緑と窓からの朝日に包まれた、独立と誕生の象徴的シーン。"
                width={1400}
                height={933}
                class="career-stages__img"
              />
              <span class="career-stages__zoom-badge" aria-hidden="true">🔍 拡大</span>
            </figure>
          </a>
        </li>
        <li class="career-stages__item">
          <a
            href="/images/career/career-it-generalist.jpg"
            target="_blank"
            rel="noopener"
            class="career-stages__zoom"
            aria-label="両言語ジェネラリストの画像を拡大表示します（新しいタブで開きます）"
          >
            <figure class="career-stages__figure">
              <ResponsiveImage
                src="/images/career/career-it-generalist.jpg"
                alt="両言語ジェネラリスト：髭ありの現代代表が中央に立ち、左パネルでクライアント経営者と経営会議（ホワイトボードにキャッシュフロー・ROI・意思決定・事業戦略）、右パネルで若手エンジニアと技術ディスカッション（API・DB・Cloud のアーキ図とシステム構成図）を行うシーン。経営の言葉とエンジニアの言葉、両方を自在に行き来できる翻訳者として描かれた本文 STRENGTH 03 連携の 3 ペイン構図。"
                width={1400}
                height={933}
                class="career-stages__img"
              />
              <span class="career-stages__zoom-badge" aria-hidden="true">🔍 拡大</span>
            </figure>
          </a>
        </li>
        <li class="career-stages__item">
          <a
            href="/images/career/career-it-ai.jpg"
            target="_blank"
            rel="noopener"
            class="career-stages__zoom"
            aria-label="AI 駆動 ── いまここ の画像を拡大表示します（新しいタブで開きます）"
          >
            <figure class="career-stages__figure">
              <ResponsiveImage
                src="/images/career/career-it-ai.jpg"
                alt="AI 駆動 ── いまここ：髭ありの現代代表が、白基調の親しみある人型 AI ロボット（暖色オレンジ LED の目・胸部に発光する AI シンボル）と横並びで肩を組んで立ち、お互いを対等な相棒として viewer 側を見据えるシーン。背景は現代マルチモニタ（コードエディタ・AI Assistant チャット・実行ログ）と窓から差す朝日のゴールド + オレンジ暖色光。本棚には「K Laboratory」の銘板が見え、3 番（独立起業）との視覚連続性も確保。シリーズ最終枚として、30 年の IT 実務 + 22 年の経営の積み重ねを経て「次の章は AI と共に」を象徴する締めくくり画像。"
                width={1400}
                height={933}
                class="career-stages__img"
              />
              <span class="career-stages__zoom-badge" aria-hidden="true">🔍 拡大</span>
            </figure>
          </a>
        </li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .profile-hero {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 32px;
    align-items: start;
  }
  .profile-hero__name {
    font-size: 22px;
    font-weight: 700;
    margin: 0 0 4px;
    color: var(--c-text);
  }
  .profile-hero__role {
    font-size: 14px;
    color: var(--c-orange-text);
    font-weight: 600;
    margin: 0 0 16px;
    letter-spacing: 0.04em;
  }
  .profile-hero__summary {
    margin: 0;
    line-height: 1.9;
    color: var(--c-text-sub);
  }
  @media (max-width: 720px) {
    .profile-hero {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  .profile-hero__photo-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    display: block;
  }

  /* 略歴タイムライン ── 期間 + 内容のペアを縦に列挙。
     モバイル：1 列縦並び。720px 以上：「期間」カラム + 「内容」カラムの 2 列。 */
  .career-timeline {
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }
  .career-timeline__period {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 700;
    color: var(--c-orange-text);
    letter-spacing: 0.02em;
    padding-left: 14px;
    border-left: 4px solid var(--c-orange-700);
    line-height: 1.5;
  }
  .career-timeline__body {
    margin: 0;
    padding-left: 18px;
    font-size: 15px;
    color: var(--c-text);
    line-height: 1.95;
  }
  .career-timeline__body p {
    margin: 0 0 14px;
  }
  .career-timeline__body p:last-child {
    margin-bottom: 0;
  }

  @media (min-width: 720px) {
    /* デスクトップでは「期間」カラム + 「内容」カラムの 2 列レイアウト */
    .career-timeline {
      grid-template-columns: minmax(140px, 180px) 1fr;
      gap: 24px 32px;
      align-items: baseline;
    }
    .career-timeline__period {
      margin: 0;
    }
    .career-timeline__body {
      padding-left: 0;
    }
  }

  /* 営業時代のループ画像群 ── 4 業界（建設/飲食/ホムセン/コスメ）を
     田の字（デスクトップ 2x2 / モバイル 1 列）で並べ、その下に「↓」
     接続矢印を挟んで、全国トップ収束図（クライマックス）を全幅で配置。
     圧縮版（田の字 1 枚に統合）はメッセージが「転職を繰り返した人」に
     見えてしまったため、元の 4 画像を残しレイアウト側で圧縮する方針。 */
  .career-loop {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .career-loop__item {
    margin: 0;
  }
  .career-loop__figure {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--c-border);
    background: var(--c-bg-alt);
    box-shadow: var(--shadow);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  .career-loop__img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* クリック拡大：4 業界画像をラップする <a target="_blank"> + 右上に
     表示する拡大バッジ。2x2 グリッドで内部 4 パネル細部が読みづらい
     問題への対応として、原寸画像（1400px 幅）を新タブで開く。
     dialog 方式は Astro の scoped CSS と ::backdrop の相性問題があり
     一部環境で暗いオーバーレイが効かなかったため、シンプルで確実な
     新タブ方式を採用。 */
  .career-loop__zoom {
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: zoom-in;
    border-radius: var(--radius);
  }
  .career-loop__zoom:hover .career-loop__figure,
  .career-loop__zoom:focus-visible .career-loop__figure {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }
  .career-loop__zoom:focus-visible .career-loop__figure {
    outline: 2px solid var(--c-orange-text);
    outline-offset: 2px;
  }
  .career-loop__zoom-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    background: rgba(26, 26, 26, 0.7);
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.04em;
    border-radius: 999px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: background-color 0.2s ease;
    pointer-events: none;
  }
  .career-loop__zoom:hover .career-loop__zoom-badge,
  .career-loop__zoom:focus-visible .career-loop__zoom-badge {
    background: var(--c-orange-text);
  }

  /* クライマックス（全国トップ）── 4 業界の下に「↓」と共に登場し、
     ストーリーが「4 業界の現場体験 → 3 年連続全国トップ」へ流れる
     視覚を作る。 */
  .career-loop__item--climax {
    position: relative;
    margin-top: 40px;
  }
  .career-loop__item--climax::before {
    content: '↓';
    display: block;
