---
// 単一行テキスト入力（text / email / tel / url）の共通部品。
// ラベル・必須マーク・補足説明・エラー文を内蔵する。
// クライアント側 JS は data-field-error 属性に文言を入れることでエラー表示を有効化する。

type InputType = 'text' | 'email' | 'tel' | 'url';

interface Props {
  /** name 属性（PHP 側で受け取るキー） */
  name: string;
  /** 表示ラベル */
  label: string;
  /** input type（既定: text） */
  type?: InputType;
  /** 必須フラグ */
  required?: boolean;
  /** プレースホルダ */
  placeholder?: string;
  /** autocomplete 属性 */
  autocomplete?: string;
  /** モバイル端末でのキーボード種別ヒント（例: tel 入力で数字キーパッド表示） */
  inputmode?: 'text' | 'numeric' | 'tel' | 'email' | 'url' | 'decimal' | 'search';
  /** HTML5 pattern 属性（正規表現による形式制約） */
  pattern?: string;
  /** 補足説明文 */
  help?: string;
  /** 追加 class */
  class?: string;
}

const {
  name,
  label,
  type = 'text',
  required = false,
  placeholder,
  autocomplete,
  inputmode,
  pattern,
  help,
  class: className,
} = Astro.props;

const fieldId = `field-${name}`;
const errorId = `${fieldId}-error`;
const helpId = `${fieldId}-help`;
---

<div class:list={['form-field', className]} data-field-name={name}>
  <label for={fieldId} class="form-field__label">
    {label}
    {required && <span class="form-field__required" aria-label="必須">必須</span>}
  </label>
  {help && <p id={helpId} class="form-field__help">{help}</p>}
  <input
    id={fieldId}
    name={name}
    type={type}
    required={required}
    placeholder={placeholder}
    autocomplete={autocomplete}
    inputmode={inputmode}
    pattern={pattern}
    aria-describedby={help ? `${helpId} ${errorId}` : errorId}
    aria-invalid="false"
    class="form-field__input"
  />
  <p id={errorId} class="form-field__error" role="alert" aria-live="polite"></p>
</div>
