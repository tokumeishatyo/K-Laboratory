---
import ResponsiveImage from './ResponsiveImage.astro';
import { NAV, SITE } from '../config/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="site-header__inner container">
    <a href="/" class="site-header__brand" aria-label={SITE.name}>
      <ResponsiveImage
        src="/images/logo.png"
        alt=""
        width={36}
        height={36}
        loading="eager"
        class="site-header__logo"
      />
      <span class="site-header__brand-name">{SITE.shortName}</span>
    </a>
    <nav class="site-nav" aria-label="メインナビゲーション">
      <ul class="site-nav__list">
        {NAV.header.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'site-nav__link',
                { 'site-nav__link--active': isActive(item.href) },
              ]}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--c-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    color: var(--c-text);
    text-decoration: none;
  }
  .site-header__brand:hover {
    text-decoration: none;
    color: var(--c-orange-700);
  }

  .site-header__logo {
    width: 36px;
    height: 36px;
    display: inline-block;
    border-radius: 6px;
    object-fit: contain;
  }

  .site-header__brand-name {
    font-size: 16px;
    letter-spacing: 0.02em;
  }

  .site-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 28px;
  }

  .site-nav__link {
    color: var(--c-text-sub);
    font-size: 15px;
    font-weight: 600;
    padding: 8px 2px;
    border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
    text-decoration: none;
  }
  .site-nav__link:hover {
    color: var(--c-orange-700);
    text-decoration: none;
  }
  .site-nav__link--active {
    color: var(--c-orange-700);
    border-bottom-color: var(--c-orange-700);
  }

  @media (max-width: 600px) {
    .site-header__brand-name {
      display: none;
    }
    .site-nav__list { gap: 18px; }
    .site-nav__link { font-size: 14px; }
  }
</style>
